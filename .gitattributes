# This file defines how Git handles tracked files.
# It normalizes text file line endings for consistency across Windows and Linux
# and marks binary files such as PDFs, images, Excel files, and videos so Git
# does not try to process them as text.

# Normalize text files in the repository
* text=auto

# Source code and web files: keep LF line endings
*.py     text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.xml    text eol=lf
*.sql    text eol=lf
*.txt    text eol=lf
*.md     text eol=lf
*.csv    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf

# Git/config files
.gitignore      text eol=lf
.gitattributes  text eol=lf

# Binary files: do not normalize or diff as text
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.xlsx  binary
*.xls   binary
*.docx  binary
*.pptx  binary
*.zip   binary
*.mp4   binary
*.mov   binary