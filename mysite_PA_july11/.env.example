# Email sending
CONDOFIX_EMAIL_ENABLED=false

# SMTP provider
CONDOFIX_SMTP_HOST=smtp.gmail.com
CONDOFIX_SMTP_PORT=465
CONDOFIX_SMTP_USE_SSL=true

# SMTP credentials
CONDOFIX_SMTP_USER=condofix.ca@gmail.com
CONDOFIX_SMTP_PASSWORD=replace-with-real-app-password
CONDOFIX_SMTP_FROM=condofix.ca@gmail.com
CONDOFIX_SECRET_KEY=replace-with-secure-random-secret

# Contact form recipients
CONDOFIX_INFO_REQUEST_RECIPIENTS=donald.boileau@gmail.com,sabourinpd@outlook.com

# database
CONDOFIX_DB_USER=CONDO_FIX_DEV
CONDOFIX_DB_PASSWORD=replace-me
CONDOFIX_DB_HOST=localhost
CONDOFIX_DB_NAME=condofix$condofix

# Application environment
CONDOFIX_ENV=DEV

# Central SQLite database
# Leave blank to use the default: condofix/Central.db
CONDOFIX_CENTRAL_DB_PATH=

# Error email notifications
CONDOFIX_ERROR_EMAIL_ENABLED=false
CONDOFIX_ERROR_EMAIL_RECIPIENTS=sabourinpd@outlook.com